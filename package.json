{
  "name": "riyaz-memon-portfolio",
  "version": "1.0.0",
  "description": "Full-stack MERN portfolio for Riyaz Memon - Software Engineer & Full Stack Developer",
  "main": "server/server.js",
  "scripts": {
    "start": "node server/server.js",
    "server": "node server/server.js",
    "client": "npm --prefix client run dev",
